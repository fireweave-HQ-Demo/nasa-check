# Copy to .env.local and fill in. .env.local is gitignored.

# NASA Open APIs key (https://api.nasa.gov). Falls back to DEMO_KEY if empty.
VITE_NASA_API_KEY=DEMO_KEY

# OpenObserve Cloud browser RUM (Ingestion -> RUM). Leave empty to disable observability.
VITE_OO_SITE=api.openobserve.ai
VITE_OO_ORG=
VITE_OO_APP_ID=
VITE_OO_CLIENT_TOKEN=

# development | preview | production
VITE_APP_ENV=development
