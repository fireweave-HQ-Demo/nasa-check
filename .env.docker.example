# Runtime config for the Docker container (copy to .env.docker; it is gitignored).
# These values are served to browsers in /config.js, so only public keys belong here.

# NASA Open APIs key (https://api.nasa.gov). Falls back to DEMO_KEY if empty.
NASA_API_KEY=

# production | preview | development
APP_ENV=production

# Release 2: Fireweave browser key (fw_public_...). Not used yet.
# FIREWEAVE_BROWSER_KEY=

# Later: OpenObserve browser RUM.
# OO_SITE=api.openobserve.ai
# OO_ORG=
# OO_APP_ID=
# OO_CLIENT_TOKEN=
